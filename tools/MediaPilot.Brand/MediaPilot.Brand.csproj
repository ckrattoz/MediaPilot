<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaPilot.Brand</RootNamespace>
    <AssemblyName>MediaPilot.Brand</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      The generator is a development tool: it never ships with the product.
      It draws the mark with the vector API of WPF, which is already part of
      the solution, so the repository does not need a new dependency.
    -->
    <Description>Generates the MediaPilot brand assets from the vector master.</Description>
  </PropertyGroup>

</Project>
