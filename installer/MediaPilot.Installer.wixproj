<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!--
      The installer is not part of the solution: it is a WiX project, built
      by build/package.ps1, and it needs the published output of the
      application to exist before it can be compiled.
    -->
    <OutputName>MediaPilot-$(ProductVersion)-x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!--
      The installer is built in Spanish, the neutral language of the product.
      The WixUI extension brings its own translation for that culture and the
      file Localization\MediaPilot.es-ES.wxl overrides the texts that are
      generic.
    -->
    <Cultures>es-ES</Cultures>
    <!--
      ICE61 complains that the product removes a version equal to itself.
      That is exactly what AllowSameVersionUpgrades asks for: reinstalling the
      same version has to replace the previous installation.
    -->
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>

  <!--
    The version comes from Directory.Build.props, the same place the
    assembly reads it from, so the installer and the application never
    disagree.
  -->
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">$(VersionPrefix)</ProductVersion>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishDirectory>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDirectory=$(PublishDirectory)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

  <!--
    The texts of the installer are in Spanish: it is the neutral language of
    the product. The file Localization\MediaPilot.es-ES.wxl overrides the
    generic texts of the WixUI extension, and its culture is the one that is
    built. The SDK includes the .wxl files of the project on its own.
  -->

  <!--
    The license that the installer shows is the real MIT license of the
    project, instead of the placeholder text that the extension brings.
  -->
  <PropertyGroup>
    <WixVariables>WixUILicenseRtf=$(MSBuildThisFileDirectory)License.rtf</WixVariables>
  </PropertyGroup>

</Project>
