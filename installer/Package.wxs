<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MediaPilot"
           Manufacturer="Antonio Nuñez"
           Version="$(ProductVersion)"
           UpgradeCode="A9874E81-9A46-4CC2-A509-42D811E30025"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="[MediaPilotDowngradeMessage]" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ApplicationIcon" SourceFile="$(PublishDirectory)Resources\Icons\active.ico" />

    <!--
      The images of the wizard. The WixUI extension brings its own, and these
      two replace them: the welcome dialog shows the mark of the application
      and every dialog carries the band of the brand.

      The size is the one of the control of the extension: 370x234 for the
      image of the welcome dialog and 370x44 for the band. The control of
      Windows Installer does not blend the image, so the alpha channel of the
      files is forced to opaque.
    -->
    <Binary Id="MediaPilot_Bmp_Welcome" SourceFile="Assets\welcome.bmp" />
    <Binary Id="MediaPilot_Bmp_Banner" SourceFile="Assets\banner.bmp" />

    <!--
      MediaPilot lives in the notification area and holds its files open, so
      the installer has to close it before it can replace or remove them. The
      application answers the close request by exiting.
    -->
    <util:CloseApplication Id="CloseMediaPilot"
                           Target="MediaPilot.App.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Description="Cierra MediaPilot para que el instalador pueda terminar." />

    <!--
      The final dialog of the wizard offers to start MediaPilot right after
      the installation.

      The extension of the interface only knows these properties: it shows
      the check box and the note when the property that holds the text of
      each of them is set, and only when the product was not installed
      before, so the option belongs to a first installation and not to an
      update.

      The texts live in the localization file of the package, the same as the
      rest of the texts of the installer.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.MediaPilotLaunchText)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.MediaPilotBackgroundNote)" />

    <!--
      The check box starts checked: after an installation the natural thing
      is to try the program that was just installed.
    -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!--
      The command line that starts the program. It is built at the moment it
      is needed, when the installation already knows where the program was
      installed.

      The property holds the path of the executable, without quotes: the
      installer uses it as the name of the program to start, and a path with
      quotes is not a path.
    -->
    <CustomAction Id="SetLaunchMediaPilot"
                  Property="LAUNCH_MEDIAPILOT"
                  Value="[INSTALLFOLDER]MediaPilot.App.exe"
                  Execute="immediate" />

    <!--
      The program starts after the user closes the final dialog with the
      "Finish" button, never while the installer is still on screen.

      The action is of type 50: the path of the executable lives in a
      property and the line of commands is the target of the action. It runs
      in the session of the user that started the installation, which is what
      a per-user installation needs. The installer does not wait for the
      program, because MediaPilot lives in the notification area and it does
      not end on its own.
    -->
    <CustomAction Id="LaunchMediaPilot"
                  Property="LAUNCH_MEDIAPILOT"
                  ExeCommand="&quot;[INSTALLFOLDER]MediaPilot.App.exe&quot;"
                  Return="asyncNoWait"
                  Execute="immediate" />

    <UI Id="MediaPilotUI">
      <!--
        The events of the "Finish" button of the final dialog. The one that
        closes the dialog belongs to the extension of the interface and has
        the order 999, so these two run after it: the program starts when
        the installer is already gone.

        The condition is the one of the check box: the program only starts
        when the user leaves it marked, and only when the product was
        installed and not updated or repaired.
      -->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="SetLaunchMediaPilot"
               Order="1000"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchMediaPilot"
               Order="1001"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
    </UI>

    <Feature Id="MainProgram" Title="MediaPilot" Level="1" AllowAbsent="no">
      <!--
        The published output is harvested as it is: every file becomes its own
        component, so the installer can repair or replace them one by one.
      -->
      <Files Include="$(PublishDirectory)**\*.*" Directory="INSTALLFOLDER" />

      <ComponentRef Id="UserProfileRegistration" />
    </Feature>

    <ComponentGroup Id="UserProfileComponents" Directory="ApplicationProgramsFolder">
      <!--
        The component that registers the program in the profile of the user:
        the shortcut of the start menu, the folder where the program was
        installed, the entry that starts it with Windows and the removal of
        the tree of files when it is uninstalled.

        The identifier of the component has a GUID of its own, so that the
        program is recognized as the same one when it is upgraded.
      -->
      <Component Id="UserProfileRegistration" Guid="6F0C2E14-3B95-4F0E-9C2A-6D7A1E4B8C33">
        <Shortcut Id="MediaPilotShortcut"
                  Name="MediaPilot"
                  Description="Global multimedia control for Windows 11"
                  Target="[INSTALLFOLDER]MediaPilot.App.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ApplicationIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <!--
          The folder where the program was installed. It is the key path of
          the component, so it lives in the registry of the user, and the
          uninstaller reads it back to remove the tree of files.
        -->
        <RegistryValue Root="HKCU"
                       Key="Software\Antonio Núñez\MediaPilot"
                       Name="InstallFolder"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
        <!--
          The entry that starts MediaPilot with Windows belongs to the
          <c>Run</c> key of the current user, and it is written by the
          application itself when the user asks for it.

          The installer writes it as well, with the argument that identifies it
          as the entry of the installer, because Windows Installer only
          removes the registry values that the package itself wrote: with this
          row the uninstaller takes the entry away with the program. The
          application reconciles it with the setting of the user when it
          starts, and it ends without running when the installer started it
          and the user has not enabled the automatic start.

          See ADR 0017.
        -->
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="MediaPilot"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]MediaPilot.App.exe&quot; --installer-startup" />
        <!--
          The program lives in the profile of the user, so the folders that
          the installation creates have to go away with it. The action of the
          Util extension walks the tree of the installation folder and adds
          the rows that remove every file and every folder of it, so the
          uninstaller leaves no empty directory behind.
        -->
        <util:RemoveFolderEx Id="RemoveInstallFolder"
                              Property="MEDIAPILOT_INSTALL_DIR"
                              Condition="REMOVE=&quot;ALL&quot;" />
      </Component>
    </ComponentGroup>

    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />
    <Property Id="ARPCOMMENTS"
              Value="Atajos multimedia globales para Windows 11." />
    <Property Id="ARPHELPLINK" Value="https://github.com/ckrattoz/MediaPilot" />

    <!--
      The uninstaller needs to know the folder where the program was
      installed in order to remove it. The folder is written to the registry
      when the program is installed, and the search reads it back when the
      program is uninstalled, because at that moment the property of the
      installation directory is no longer resolved.
    -->
    <Property Id="MEDIAPILOT_INSTALL_DIR">
      <RegistrySearch Id="FindInstallFolder"
                      Root="HKCU"
                      Key="Software\Antonio Núñez\MediaPilot"
                      Name="InstallFolder"
                      Type="directory" />
    </Property>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

  <Fragment>
    <!--
      The application is installed for the current user: it lives in the
      profile of that user, next to its settings, and the installation does
      not need administrator permissions.
    -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Programs\MediaPilot" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MediaPilot" />
    </StandardDirectory>
  </Fragment>

</Wix>
