<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="MediaPilot"
           Manufacturer="ckrattoz"
           Version="$(ProductVersion)"
           UpgradeCode="A9874E81-9A46-4CC2-A509-42D811E30025"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="[MediaPilotDowngradeMessage]" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ApplicationIcon" SourceFile="$(PublishDirectory)Resources\Icons\active.ico" />

    <!--
      MediaPilot lives in the notification area and holds its files open, so
      the installer has to close it before it can replace or remove them. The
      application answers the close request by exiting.
    -->
    <util:CloseApplication Id="CloseMediaPilot"
                           Target="MediaPilot.App.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Description="Cierra MediaPilot para que el instalador pueda terminar." />

    <Feature Id="MainProgram" Title="MediaPilot" Level="1" AllowAbsent="no">
      <!--
        The published output is harvested as it is: every file becomes its own
        component, so the installer can repair or replace them one by one.
      -->
      <Files Include="$(PublishDirectory)**\*.*" Directory="INSTALLFOLDER" />

      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="RemoveStartupRegistration" />
    </Feature>

    <ComponentGroup Id="StartMenuComponents" Directory="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="6F0C2E14-3B95-4F0E-9C2A-6D7A1E4B8C33">
        <Shortcut Id="MediaPilotShortcut"
                  Name="MediaPilot"
                  Description="Global multimedia control for Windows 11"
                  Target="[INSTALLFOLDER]MediaPilot.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\ckrattoz\MediaPilot"
                       Name="InstallFolder"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="UninstallCleanupComponents" Directory="INSTALLFOLDER">
      <Component Id="RemoveStartupRegistration" Guid="2B6F4A18-7C3D-4E9A-8B05-6F1D9E7C4A22">
        <!--
          The entry that starts MediaPilot with Windows is written by the
          application itself, in the Run key of the current user, and only
          when the user asks for it. The installer removes it when the
          program is uninstalled, so that a leftover entry does not try to
          start an executable that no longer exists.

          The row has no install action: it only removes the value when the
          program is uninstalled.
        -->
        <RemoveRegistryValue Root="HKCU"
                             Key="Software\Microsoft\Windows\CurrentVersion\Run"
                             Name="MediaPilot" />
      </Component>
    </ComponentGroup>

    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />
    <Property Id="ARPCOMMENTS"
              Value="Atajos multimedia globales para Windows 11." />
    <Property Id="ARPHELPLINK" Value="https://github.com/ckrattoz/MediaPilot" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MediaPilot" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MediaPilot" />
    </StandardDirectory>
  </Fragment>

</Wix>
