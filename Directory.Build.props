<Project>

  <!-- Properties shared by every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The runtime must not run in globalization-invariant mode. WPF resolves
      its default language as "en-US" and the font cache builds real cultures,
      so in invariant mode every window that shows text dies with a
      CultureNotFoundException. The application needs the real cultures to
      resolve the strings of the interface as well. See
      docs/architecture/adr/0010-wpf-and-globalization-invariant-mode.md.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NeutralLanguage>es</NeutralLanguage>
  </PropertyGroup>

  <!-- Quality: analyzers plus warnings as errors. -->
  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <!-- Build reproducibility. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols Condition="'$(Configuration)' == 'Release'">true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Product metadata. -->
  <PropertyGroup>
    <Product>MediaPilot</Product>
    <Company>Antonio Nuñez</Company>
    <Authors>Antonio Nuñez</Authors>
    <Copyright>Copyright (c) 2026 ckrattoz</Copyright>
    <VersionPrefix>0.2.1</VersionPrefix>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- The test projects are not packaged. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <!--
      CA1707 (underscores in names) is disabled for the tests: the
      Method_Scenario convention is idiomatic in xUnit and describes every
      case better than a flat name.
    -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
