# Normalize the line endings of the text files so that the repository is
# reproducible on every machine, and keep the exception declared in
# .editorconfig: the PowerShell and batch scripts use CRLF.

* text=auto eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touched.
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.snupkg binary
*.nupkg binary
*.exe  binary
*.dll  binary
*.pdb  binary
