<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaPilot.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      The icon of the executable. It is the same mark that the notification
      area shows, generated by the brand tool from the vector master.
    -->
    <ApplicationIcon>Resources\Icons\active.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaPilot.Core\MediaPilot.Core.csproj" />
    <ProjectReference Include="..\MediaPilot.Platform\MediaPilot.Platform.csproj" />
    <ProjectReference Include="..\MediaPilot.Configuration\MediaPilot.Configuration.csproj" />
    <ProjectReference Include="..\MediaPilot.UI\MediaPilot.UI.csproj" />
    <ProjectReference Include="..\MediaPilot.Localization\MediaPilot.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The icons of the notification area travel with the application: the
      tray service loads them from the folder of the executable.
    -->
    <None Include="Resources\Icons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
