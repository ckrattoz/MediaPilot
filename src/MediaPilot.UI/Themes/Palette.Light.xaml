<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MediaPilot light palette.

        It is declared explicitly instead of inheriting the resources of the
        Fluent theme: that way the application does not depend on keys the
        framework may still rename, and the visual result is identical on any
        version of .NET.
    -->

    <SolidColorBrush x:Key="MediaPilot.Brush.Surface" Color="#F9F9F9" />
    <SolidColorBrush x:Key="MediaPilot.Brush.SurfaceStroke" Color="#E5E5E5" />
    <SolidColorBrush x:Key="MediaPilot.Brush.TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.TextSecondary" Color="#5D5D5D" />
    <SolidColorBrush x:Key="MediaPilot.Brush.Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentHover" Color="#1975C5" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentPressed" Color="#31589B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlBackgroundHover" Color="#F6F6F6" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlStroke" Color="#D0D0D0" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlStrokeFocused" Color="#0067C0" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlText" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.Separator" Color="#EAEAEA" />

</ResourceDictionary>
