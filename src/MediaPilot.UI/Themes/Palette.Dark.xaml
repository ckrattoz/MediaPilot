<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MediaPilot dark palette.

        On a dark surface the orange of the brand reaches the contrast of the
        interface without being darkened, so the accent is the same orange
        that the mark uses. The text on top of it is dark, because that is the
        only combination that stays legible.
    -->

    <SolidColorBrush x:Key="MediaPilot.Brush.Surface" Color="#202020" />
    <SolidColorBrush x:Key="MediaPilot.Brush.SurfaceStroke" Color="#3A3A3A" />
    <SolidColorBrush x:Key="MediaPilot.Brush.TextPrimary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MediaPilot.Brush.TextSecondary" Color="#A6A6A6" />
    <SolidColorBrush x:Key="MediaPilot.Brush.Accent" Color="#FF8A2B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentHover" Color="#FFA052" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentPressed" Color="#E2761B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.AccentText" Color="#241100" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlBackgroundHover" Color="#383838" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlStroke" Color="#4A4A4A" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlStrokeFocused" Color="#FF8A2B" />
    <SolidColorBrush x:Key="MediaPilot.Brush.ControlText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="MediaPilot.Brush.Separator" Color="#333333" />

    <!-- The lime of the brand: the level of the volume and the accents. -->
    <SolidColorBrush x:Key="MediaPilot.Brush.BrandLime" Color="#B6E24A" />
    <SolidColorBrush x:Key="MediaPilot.Brush.BrandLimeTrack" Color="#3A3A3A" />

</ResourceDictionary>
