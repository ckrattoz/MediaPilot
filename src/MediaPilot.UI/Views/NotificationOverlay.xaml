<Window x:Class="MediaPilot.UI.Views.NotificationOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource MediaPilot.Brush.Surface}">

    <Border Margin="1"
            Padding="16"
            CornerRadius="8"
            Background="{DynamicResource MediaPilot.Brush.Surface}"
            BorderBrush="{DynamicResource MediaPilot.Brush.SurfaceStroke}"
            BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource MediaPilot.Brush.TextPrimary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource MediaPilot.Brush.TextSecondary}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
