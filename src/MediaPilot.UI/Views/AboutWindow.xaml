<Window x:Class="MediaPilot.UI.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MediaPilot.UI.Resources"
        Title="{loc:Localize About_WindowTitle}"
        Icon="pack://application:,,,/MediaPilot.UI;component/Resources/Brand/mark-32.png"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource MediaPilot.Brush.Surface}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The header of the window: the mark of the application at its
            largest size next to the name of the product and its version.
        -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0"
                   Width="128" Height="128"
                   VerticalAlignment="Top"
                   Source="pack://application:,,,/MediaPilot.UI;component/Resources/Brand/mark-128.png" />

            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize App_Name}"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="{DynamicResource MediaPilot.Brush.TextPrimary}" />
                <TextBlock Text="{loc:Localize App_Tagline}"
                           Margin="0,4,0,0"
                           Style="{StaticResource MediaPilot.Caption}" />
                <TextBlock x:Name="VersionText"
                           Margin="0,12,0,0"
                           Style="{StaticResource MediaPilot.Caption}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,0"
                Style="{StaticResource MediaPilot.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource MediaPilot.SectionTitle}"
                           Text="{loc:Localize About_Section_Info}" />
                <TextBlock Style="{StaticResource MediaPilot.Caption}"
                           Text="{loc:Localize About_Info_Body}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0"
                Style="{StaticResource MediaPilot.Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource MediaPilot.SectionTitle}"
                           Text="{loc:Localize About_Section_Shortcuts}" />
                <StackPanel x:Name="ShortcutsHost" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!--
            Footer of the window: the copyright of the product and the link
            to the documentation of the project.
        -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource MediaPilot.Caption}"
                       Text="{loc:Localize About_Copyright}" />

            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://github.com/ckrattoz/MediaPilot"
                           RequestNavigate="OnDocumentationClick"
                           Foreground="{DynamicResource MediaPilot.Brush.Accent}"
                           Cursor="Hand">
                    <Run Text="{loc:Localize About_Documentation}"
                         Foreground="{DynamicResource MediaPilot.Brush.Accent}" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,18,0,0" HorizontalAlignment="Right">
            <Button Content="{loc:Localize About_Button_Close}"
                    Style="{StaticResource MediaPilot.AccentButton}"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
