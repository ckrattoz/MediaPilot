<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>MediaPilot.UI</RootNamespace>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaPilot.Core\MediaPilot.Core.csproj" />
    <ProjectReference Include="..\MediaPilot.Platform\MediaPilot.Platform.csproj" />
    <ProjectReference Include="..\MediaPilot.Configuration\MediaPilot.Configuration.csproj" />
    <ProjectReference Include="..\MediaPilot.Localization\MediaPilot.Localization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The brand of the application: the mark of the tile and the wave. The
      files are generated by the brand tool from the vector master, and they
      are embedded as resources so that the views can show them with a pack
      URI.
    -->
    <Resource Include="Resources\Brand\*.png" />
    <Resource Include="Resources\Brand\*.ico" />
  </ItemGroup>

</Project>
