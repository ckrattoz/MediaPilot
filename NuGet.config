<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Reproducible package sources for the solution.

    <clear /> is declared so that the restore does not depend on the global
    configuration of each machine: the solution always restores from the same
    sources.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
